---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { Language } from "../i18n/translations";

interface Props {
    lang?: Language;
}

const { lang = "en" } = Astro.props;
---

<div class="window">
    <header class="window__bar">
        <div class="window__identity">
            <span class="window__mark">✦</span>
            <span class="window__title">itsukaoi.dev</span>
        </div>

        <div class="window__actions">
            <LanguageSwitcher lang={lang} />
        </div>

        <div class="window__controls" aria-hidden="true">
            <span class="window__control">
                <svg
                    viewBox="0 0 24 24"
                    width="15"
                    height="15"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                >
                    <path d="M5 12h14"></path>
                </svg>
            </span>

            <span class="window__control">
                <svg
                    viewBox="0 0 24 24"
                    width="13"
                    height="13"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                >
                    <rect width="14" height="14" x="5" y="5" rx="1"></rect>
                </svg>
            </span>

            <span class="window__control">
                <svg
                    viewBox="0 0 24 24"
                    width="15"
                    height="15"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </span>
        </div>
    </header>

    <main class="window__content">
        <slot />
    </main>
</div>
